# ===================================================================
# KisanMitra Configuration
# ===================================================================

# Server Port (assigned dynamically by Render/Heroku or defaults to 8080)
PORT=8080

# Google Gemini API Key for KisanBot AI Multi-Turn Chat
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------------
# Email Intimation System
# -------------------------------------------------------------------

# Sender Email Address (Used as the "From" address for APMC notifications)
GMAIL_SENDER_EMAIL=your_email@gmail.com

# HTTP Email API Keys (RECOMMENDED for Render / Cloud hosting where SMTP ports are blocked)
# 1. Brevo (Sendinblue) — Free tier includes 300 emails/day: https://www.brevo.com/
BREVO_API_KEY=

# 2. Resend — Free tier includes 100 emails/day: https://resend.com/
RESEND_API_KEY=
RESEND_SENDER_EMAIL=KisanMitra APMC <onboarding@resend.dev>

# 3. SendGrid — Free tier: https://sendgrid.com/
SENDGRID_API_KEY=

# 4. Mailgun — Free tier: https://www.mailgun.com/
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# SMTP Fallback (Works for local development or VPS where SMTP ports 587/465 are unblocked)
# Google App Password (16 characters from myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=
